<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Desktop-only targets for e_sqlcipher native library.
    iOS and Android have their own TFM-specific targets files
    (e_sqlcipher.native.ios.targets and e_sqlcipher.native.android.targets).

    Guard: skip this entirely for mobile platforms so the macOS dylib
    is never accidentally picked up during iOS/Android MAUI builds
    (where the build host is macOS and RuntimeIdentifier can be empty
    during the outer build phase).
  -->
  <PropertyGroup>
    <_ESqlCipherIsMobileBuild Condition=" '$(TargetPlatformIdentifier)' == 'ios' OR '$(TargetPlatformIdentifier)' == 'android' OR '$(TargetPlatformIdentifier)' == 'tvos' OR '$(TargetPlatformIdentifier)' == 'maccatalyst' ">true</_ESqlCipherIsMobileBuild>
  </PropertyGroup>

  <ItemGroup Condition=" '$(_ESqlCipherIsMobileBuild)' != 'true' AND ('$(RuntimeIdentifier)' == 'linux-x64' OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64')) ">
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/linux-x64/native/libe_sqlcipher.so">
      <Link>libe_sqlcipher.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition=" '$(_ESqlCipherIsMobileBuild)' != 'true' AND ('$(RuntimeIdentifier)' == 'linux-arm64' OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Linux')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64')) ">
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/linux-arm64/native/libe_sqlcipher.so">
      <Link>libe_sqlcipher.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition=" '$(_ESqlCipherIsMobileBuild)' != 'true' AND ('$(RuntimeIdentifier)' == 'osx-x64' OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64')) ">
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/osx-x64/native/libe_sqlcipher.dylib">
      <Link>libe_sqlcipher.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition=" '$(_ESqlCipherIsMobileBuild)' != 'true' AND ('$(RuntimeIdentifier)' == 'osx-arm64' OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64')) ">
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native/libe_sqlcipher.dylib">
      <Link>libe_sqlcipher.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition=" '$(_ESqlCipherIsMobileBuild)' != 'true' AND ('$(RuntimeIdentifier)' == 'win-x64' OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64')) ">
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/win-x64/native/e_sqlcipher.dll">
      <Link>e_sqlcipher.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition=" '$(_ESqlCipherIsMobileBuild)' != 'true' AND ('$(RuntimeIdentifier)' == 'win-arm64' OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64')) ">
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/e_sqlcipher.dll">
      <Link>e_sqlcipher.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
