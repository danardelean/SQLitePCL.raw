<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>e_sqlcipher</id>
    <version>$version$</version>
    <authors>SQLCipher Contributors</authors>
    <license type="expression">BSD-3-Clause</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/sqlcipher/sqlcipher</projectUrl>
    <description>Native SQLCipher 4.14.0 builds (based on SQLite 3.51.3) for use with SQLitePCLRaw. Provides encrypted SQLite database support via the e_sqlcipher provider. Includes builds for Windows (x64, arm64), Linux (x64, arm64), and macOS (x64, arm64). Linux/Windows use OpenSSL for crypto; macOS uses CommonCrypto.</description>
    <copyright>Copyright 2008-2026 Zetetic LLC. All rights reserved.</copyright>
    <tags>sqlite sqlcipher encryption native</tags>
    <repository type="git" url="https://github.com/sqlcipher/sqlcipher" />
  </metadata>
  <files>
    <!-- Linux -->
    <file src="../native/linux-x64/libe_sqlcipher.so" target="runtimes/linux-x64/native/libe_sqlcipher.so" />
    <file src="../native/linux-arm64/libe_sqlcipher.so" target="runtimes/linux-arm64/native/libe_sqlcipher.so" />

    <!-- macOS -->
    <file src="../native/osx-x64/libe_sqlcipher.dylib" target="runtimes/osx-x64/native/libe_sqlcipher.dylib" />
    <file src="../native/osx-arm64/libe_sqlcipher.dylib" target="runtimes/osx-arm64/native/libe_sqlcipher.dylib" />

    <!-- Windows -->
    <file src="../native/win-x64/e_sqlcipher.dll" target="runtimes/win-x64/native/e_sqlcipher.dll" />
    <file src="../native/win-arm64/e_sqlcipher.dll" target="runtimes/win-arm64/native/e_sqlcipher.dll" />

    <!-- Targets file to copy native to output -->
    <file src="e_sqlcipher.native.targets" target="build/e_sqlcipher.targets" />
    <file src="e_sqlcipher.native.targets" target="buildTransitive/e_sqlcipher.targets" />

    <file src="README.md" target="README.md" />
  </files>
</package>
