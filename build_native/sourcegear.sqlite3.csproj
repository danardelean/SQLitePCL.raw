<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packaging-only project for locally-built native e_sqlite3 (plain SQLite, no encryption) -->
  <!-- Used in CI to satisfy SourceGear.sqlite3 dependency for testing -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>sourcegear.sqlite3.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
  </PropertyGroup>

</Project>
