<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    iOS native targets for e_sqlcipher.
    Uses NativeReference to statically link the SQLCipher .a library into the app.
    This is required because iOS uses provider.internal with [DllImport("__Internal")].
  -->

  <!-- iOS device (arm64) -->
  <ItemGroup Condition=" '$(RuntimeIdentifier)' == 'ios-arm64' OR ('$(TargetPlatformIdentifier)' == 'ios' AND '$(RuntimeIdentifier)' == '') ">
    <NativeReference Condition="Exists('$(MSBuildThisFileDirectory)../../runtimes/ios-arm64/native/libe_sqlcipher.a')"
                     Include="$(MSBuildThisFileDirectory)../../runtimes/ios-arm64/native/libe_sqlcipher.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Security CoreFoundation</Frameworks>
    </NativeReference>
  </ItemGroup>

  <!-- iOS simulator (arm64 — Apple Silicon Macs) -->
  <ItemGroup Condition=" '$(RuntimeIdentifier)' == 'iossimulator-arm64' ">
    <NativeReference Condition="Exists('$(MSBuildThisFileDirectory)../../runtimes/iossimulator-arm64/native/libe_sqlcipher.a')"
                     Include="$(MSBuildThisFileDirectory)../../runtimes/iossimulator-arm64/native/libe_sqlcipher.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Security CoreFoundation</Frameworks>
    </NativeReference>
  </ItemGroup>

  <!-- iOS simulator (x86_64 — Intel Macs) -->
  <ItemGroup Condition=" '$(RuntimeIdentifier)' == 'iossimulator-x64' ">
    <NativeReference Condition="Exists('$(MSBuildThisFileDirectory)../../runtimes/iossimulator-x64/native/libe_sqlcipher.a')"
                     Include="$(MSBuildThisFileDirectory)../../runtimes/iossimulator-x64/native/libe_sqlcipher.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Security CoreFoundation</Frameworks>
    </NativeReference>
  </ItemGroup>
</Project>
