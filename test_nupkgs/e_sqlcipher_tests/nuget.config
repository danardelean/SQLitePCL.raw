<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The tests consume the packages the way an application does: the four
    e_sqlcipher packages from the local build output, everything else
    (SQLitePCLRaw.core, provider.internal, ugly, ...) from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="local" value="../../nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="e_sqlcipher" />
      <package pattern="SQLitePCLRaw.bundle_e_sqlcipher" />
      <package pattern="SQLitePCLRaw.config.e_sqlcipher" />
      <package pattern="SQLitePCLRaw.provider.e_sqlcipher" />
    </packageSource>
  </packageSourceMapping>
</configuration>
