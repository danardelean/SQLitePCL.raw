<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The tests consume the packages the way an application does: e_sqlcipher and
    every SQLitePCLRaw.* package (core, providers, ugly, ...) from the local build
    output, everything else (Microsoft.Data.Sqlite.Core, ...) from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="local" value="../../nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="e_sqlcipher" />
      <package pattern="SQLitePCLRaw.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
