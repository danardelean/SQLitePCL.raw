<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core test suite (src/common/tests_xunit.cs) against the e_sqlcipher bundle,
       plus the crypto tests (TEST_WITH_CRYPTO) and the SQLCipher fixture tests (TEST_SQLCIPHER). -->
  <PropertyGroup>
    <TargetFrameworks>$(tfm_framework);$(tfm_net);$(tfm_windows)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);TEST_WITH_CRYPTO;TEST_SQLCIPHER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == '$(tfm_framework)' ">
      <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="sqlitepclraw.bundle_e_sqlcipher" Version="$(pkg_version_for_testing)" />
    <PackageReference Include="sqlitepclraw.ugly" Version="$(pkg_version_for_testing)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\src\common\attrs_for_tests.cs" />
    <Compile Include="..\..\..\src\common\fake_xunit.cs" />
    <Compile Include="..\..\..\src\common\tests_xunit.cs" />
    <EmbeddedResource Include="..\..\..\src\common\sqlcipher-4.0-testkey.db" LogicalName="sqlcipher-4.0-testkey.db" />
  </ItemGroup>
</Project>
